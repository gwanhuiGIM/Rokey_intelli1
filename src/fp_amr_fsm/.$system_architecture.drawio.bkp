        <mxCell id="bridge" value="safety_alert_bridge 노드&#xa;&#xa;PC3 /safety/* → /alert/* 변환&#xa;PoseStamped → String JSON&#xa;helmet: 에피소드당 첫 goal 1회만 중계" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="pc4" vertex="1">
