        <mxCell id="f_diag" value="로봇 상태 진단&#xa;raw 토픽 직접 구독 판단&#xa;OFFLINE / NO_LOCALIZATION / NO_NAV2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;fontSize=10;" parent="fleet" vertex="1">
          <mxGeometry x="20" y="40" width="270" height="90" as="geometry" />
