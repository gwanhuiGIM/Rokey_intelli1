        <mxCell id="f_dispatch" value="출동 배정&#xa;EMERGENCY 최우선(HELMET 선점 허용)&#xa;최단거리 선정, abort 시 최대 3회 재배정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;fontSize=10;" parent="fleet" vertex="1">
          <mxGeometry x="310" y="40" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_patrol" value="자동 순찰 / 교대&#xa;patrol_period(300s)마다 배터리 최고 idle 배정&#xa;PATROL→RETURNING 전이 시 순찰 재배정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;fontSize=10;" parent="fleet" vertex="1">
          <mxGeometry x="20" y="150" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_batt" value="배터리 히스테리시스&#xa;low 0.30 / dispatch_min 0.40 / resume 0.90&#xa;복귀 직후 재배정 핑퐁 방지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;fontSize=10;" parent="fleet" vertex="1">
